{
  "name": "design-system-skeleton",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "description": "One design system for all of Sharon's products: a shared base with a theme for each product.",
  "scripts": {
    "tokens": "node scripts/build-tokens.mjs",
    "build:lib": "vite build -c vite.lib.config.ts && tsc -p tsconfig.build.json",
    "prepare": "npm run tokens && npm run build:lib",
    "test": "npm run tokens && vitest run",
    "storybook": "node scripts/storybook-dev.mjs",
    "build-storybook": "npm run tokens && storybook build -o storybook-static",
    "typecheck": "tsc --noEmit",
    "test:update": "npm run tokens && vitest run -u",
    "test:visual": "playwright test",
    "test:visual:update": "playwright test --update-snapshots"
  },
  "devDependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "@fontsource/archivo": "^5.3.0",
    "@fontsource/atkinson-hyperlegible-next": "^5.3.0",
    "@fontsource/cinzel": "^5.3.0",
    "@fontsource/figtree": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@playwright/test": "^1.56.1",
    "@storybook/addon-a11y": "^10.6.0",
    "@storybook/addon-docs": "^10.6.0",
    "@storybook/addon-mcp": "^10.6.1",
    "@storybook/react-vite": "^10.6.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^22.20.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "axe-core": "^4.13.0",
    "http-server": "^14.1.1",
    "jsdom": "^30.1.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "storybook": "^10.6.0",
    "style-dictionary": "^5.5.5",
    "typescript": "^5.9.3",
    "vite": "^8.3.1",
    "vitest": "^5.0.2",
    "wcag-contrast": "^3.0.0"
  },
  "dependencies": {
    "react-aria-components": "^1.21.1"
  },
  "exports": {
    ".": {
      "types": "./dist/types/components/index.d.ts",
      "import": "./dist/index.js"
    },
    "./base.css": "./dist/base.css",
    "./components.css": "./dist/index.css",
    "./themes/*.css": "./build/css/*.css",
    "./fonts/after-graduation.css": "./dist/fonts-after-graduation.css",
    "./fonts/life-hub.css": "./dist/fonts-life-hub.css"
  },
  "files": [
    "dist",
    "build/css"
  ],
  "sideEffects": [
    "*.css"
  ],
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  }
}
