      "$value": "0px 1px 2px 0px rgba(13,11,9,0.24), inset 0px 1px 0px 0px rgba(248,240,232,0.05)",
      "$description": "Solid panels: shadow.rest plus shadow.edge. Glass settings are off."
    },
    "shadow-hover": {
      "$value": "0px 2px 6px 0px rgba(13,11,9,0.28), inset 0px 1px 0px 0px rgba(248,240,232,0.05)",
      "$description": "Solid panels on hover: shadow.hover plus shadow.edge."
    },
