{
  "shadow": {
    "$description": "Depth, not flatness: a 1px light along the top edge plus a tight dark shadow. Raised panels get lighter instead of casting heavy shadows. Only floating layers (popovers, floating toolbars) cast a real shadow.",
    "edge": {
      "$type": "shadow",
      "$value": [
        {
          "color": "rgba(0,0,0,0)",
          "offsetX": "0px",
          "offsetY": "0px",
          "blur": "0px",
          "spread": "0px"
        }
      ],
      "$description": "Empty: shadow.rest already carries the top-edge light."
    },
    "rest": {
      "$type": "shadow",
      "$value": [
        {
          "color": "rgba(248,240,232,0.05)",
          "offsetX": "0px",
          "offsetY": "1px",
          "blur": "0px",
          "spread": "0px",
          "inset": true
        },
        {
          "color": "rgba(0,0,0,0.40)",
          "offsetX": "0px",
          "offsetY": "1px",
          "blur": "2px",
          "spread": "0px"
        }
      ],
      "$description": "A 1px cream light along the top edge, plus a tight shadow."
    },
    "hover": {
      "$type": "shadow",
      "$value": [
        {
          "color": "rgba(248,240,232,0.07)",
          "offsetX": "0px",
          "offsetY": "1px",
          "blur": "0px",
          "spread": "0px",
          "inset": true
        },
        {
          "color": "rgba(0,0,0,0.48)",
          "offsetX": "0px",
          "offsetY": "2px",
          "blur": "4px",
          "spread": "0px"
        }
      ]
    },
    "float": {
      "$type": "shadow",
      "$value": [
        {
          "color": "rgba(0,0,0,0.35)",
          "offsetX": "0px",
          "offsetY": "2px",
          "blur": "6px",
          "spread": "0px"
        },
        {
          "color": "rgba(0,0,0,0.50)",
          "offsetX": "0px",
          "offsetY": "12px",
          "blur": "32px",
          "spread": "0px"
        }
      ],
      "$description": "Popovers and floating toolbars, the only things that float above the page."
    }
  }
}
