{
  "color": {
    "status": {
      "$description": "The Designer Toolkit's status colors (Oct 12): fire red for errors, lit honey for warnings, lake green for success, peach for info. The names and rules are shared by every theme (always with an icon and a label, text passes 4.5:1). Error has its own text color on its solid fill (on-accent-strong); the other statuses' solid fills take the inverse ink, so they are light steps.",
      "error": {
        "surface": {
          "$type": "color",
          "$value": "{palette.fire-red.800}"
        },
        "accent": {
          "$type": "color",
          "$value": "{palette.fire-red.300}"
        },
        "accent-strong": {
          "$type": "color",
          "$value": "{palette.fire-red.600}",
          "$description": "Fire is lit: the solid danger fill, fire red 600, for destructive buttons and the error icon."
        },
        "ink": {
          "$type": "color",
          "$value": "{palette.fire-red.200}"
        },
        "$description": "Fire red. Ink is fire red 200 on fire red 800 (9.2:1). The solid danger fill is fire red 600 with cream text (5.2:1). Fire red 400 and lighter are never text.",
        "on-accent-strong": {
          "$type": "color",
          "$value": "{palette.cream.100}",
          "$description": "Cream on the fire red fill: 5.2:1."
        },
        "accent-strong-hover": {
          "$type": "color",
          "$value": "{palette.fire-red.700}",
          "$description": "The danger fill on hover and press: fire red 700, a little deeper, with the same cream text."
        }
      },
      "warning": {
        "surface": {
          "$type": "color",
          "$value": "{palette.honey.200}"
        },
        "accent": {
          "$type": "color",
          "$value": "{palette.honey.300}"
        },
        "accent-strong": {
          "$type": "color",
          "$value": "{palette.honey.200}"
        },
        "ink": {
          "$type": "color",
          "$value": "{palette.near-black.900}"
        },
        "$description": "Honey, lit: the honey itself is the surface, with near-black ink (10.3:1). Warnings are the only place honey appears."
      },
      "success": {
        "surface": {
          "$type": "color",
          "$value": "{palette.lake-green.800}"
        },
        "accent": {
          "$type": "color",
          "$value": "{palette.lake-green.400}"
        },
        "accent-strong": {
          "$type": "color",
          "$value": "{palette.lake-green.300}"
        },
        "ink": {
          "$type": "color",
          "$value": "{palette.lake-green.200}"
        }
      },
      "info": {
        "surface": {
          "$type": "color",
          "$value": "{palette.peach.700}"
        },
        "accent": {
          "$type": "color",
          "$value": "{palette.peach.400}"
        },
        "accent-strong": {
          "$type": "color",
          "$value": "{palette.peach.300}"
        },
        "ink": {
          "$type": "color",
          "$value": "{palette.peach.200}"
        }
      },
      "neutral": {
        "surface": {
          "$type": "color",
          "$value": "{palette.near-black.700}"
        },
        "accent": {
          "$type": "color",
          "$value": "{palette.near-black.500}"
        },
        "accent-strong": {
          "$type": "color",
          "$value": "{palette.near-black.400}"
        },
        "ink": {
          "$type": "color",
          "$value": "{palette.cream.200}"
        }
      }
    }
  }
}
