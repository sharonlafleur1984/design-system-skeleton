{
  "color": {
    "status": {
      "$description": "Fireside's status colors, with Retro's surfaces and text (Oct 13): red for danger, green for success, yellow for warnings only. The names and rules are shared by every theme (always with an icon and a label, text passes 4.5:1).",
      "error": {
        "surface": {
          "$type": "color",
          "$value": "#fceeeb"
        },
        "accent": {
          "$type": "color",
          "$value": "#bf2b07"
        },
        "accent-strong": {
          "$type": "color",
          "$value": "#841a03"
        },
        "ink": {
          "$type": "color",
          "$value": "#5c0f01"
        }
      },
      "warning": {
        "surface": {
          "$type": "color",
          "$value": "#fbf1d7"
        },
        "accent": {
          "$type": "color",
          "$value": "#917302"
        },
        "accent-strong": {
          "$type": "color",
          "$value": "#765d01"
        },
        "ink": {
          "$type": "color",
          "$value": "#3d2e00"
        }
      },
      "success": {
        "surface": {
          "$type": "color",
          "$value": "#e3ebea"
        },
        "accent": {
          "$type": "color",
          "$value": "#546462"
        },
        "accent-strong": {
          "$type": "color",
          "$value": "#304341"
        },
        "ink": {
          "$type": "color",
          "$value": "#0f1817"
        }
      },
      "info": {
        "surface": {
          "$type": "color",
          "$value": "#f9f0e9"
        },
        "accent": {
          "$type": "color",
          "$value": "#6b5e52"
        },
        "accent-strong": {
          "$type": "color",
          "$value": "#50463c"
        },
        "ink": {
          "$type": "color",
          "$value": "#362f28"
        }
      },
      "neutral": {
        "surface": {
          "$type": "color",
          "$value": "#f2f2f1"
        },
        "accent": {
          "$type": "color",
          "$value": "#63605d"
        },
        "accent-strong": {
          "$type": "color",
          "$value": "#4b4743"
        },
        "ink": {
          "$type": "color",
          "$value": "#1a1612"
        }
      }
    }
  }
}
