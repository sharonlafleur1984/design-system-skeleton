{
  "motion": {
    "arrive": {
      "$description": "The Designer Toolkit defaults to calm: panels and menus arrive slowly and quietly, and never bounce, so the prototype keeps the attention.",
      "duration": { "$type": "duration", "$value": "{motion.mood.calm.arrive-duration}" },
      "easing": { "$type": "cubicBezier", "$value": "{motion.mood.calm.arrive-easing}" },
      "distance": { "$type": "dimension", "$value": "{motion.mood.calm.arrive-distance}" }
    },
    "celebrate": {
      "duration": { "$type": "duration", "$value": "{motion.mood.calm.celebrate-duration}" },
      "easing": { "$type": "cubicBezier", "$value": "{motion.mood.calm.celebrate-easing}" },
      "scale": { "$type": "number", "$value": "{motion.mood.calm.celebrate-scale}" }
    }
  }
}
