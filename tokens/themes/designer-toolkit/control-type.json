{
  "control": {
    "type": {
      "$description": "Text for controls, one style per control size. Smaller than After Graduation's, so it fits the toolkit's compact heights (24, 28, 32px). Every line height lands on the 4-point grid and fits inside its control height.",
      "small": {
        "size": {
          "$type": "dimension",
          "$value": "12px"
        },
        "line-height": {
          "$type": "number",
          "$value": 1.33333
        },
        "weight": {
          "$type": "fontWeight",
          "$value": "{font.weight.medium}"
        }
      },
      "medium": {
        "size": {
          "$type": "dimension",
          "$value": "12px"
        },
        "line-height": {
          "$type": "number",
          "$value": 1.33333
        },
        "weight": {
          "$type": "fontWeight",
          "$value": "{font.weight.medium}"
        }
      },
      "large": {
        "size": {
          "$type": "dimension",
          "$value": "14px"
        },
        "line-height": {
          "$type": "number",
          "$value": 1.42857
        },
        "weight": {
          "$type": "fontWeight",
          "$value": "{font.weight.medium}"
        }
      }
    }
  }
}
