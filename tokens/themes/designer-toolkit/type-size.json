{
  "type": {
    "$description": "Fireside's type scale. Sizes sit on the 4-point grid (14px is the one exception for UI text, 10px the one for the small capital section label). Line heights are ratios picked so size times ratio lands on a multiple of 4. Titles get smaller on tablets and phones; text inside the interface never does.",
    "display-cover": {
      "size": {
        "$type": "dimension",
        "$value": "56px",
        "$extensions": {
          "com.sharon.screen-class": {
            "compact": "32px",
            "medium": "48px"
          }
        }
      },
      "line-height": {
        "$type": "number",
        "$value": 1.07143,
        "$extensions": {
          "com.sharon.screen-class": {
            "compact": 1.125,
            "medium": 1.08333
          }
        }
      }
    },
    "display-xl": {
      "size": {
        "$type": "dimension",
        "$value": "48px",
        "$extensions": {
          "com.sharon.screen-class": {
            "compact": "28px",
            "medium": "40px"
          }
        }
      },
      "line-height": {
        "$type": "number",
        "$value": 1.08333,
        "$extensions": {
          "com.sharon.screen-class": {
            "compact": 1.14286,
            "medium": 1.1
          }
        }
      }
    },
    "display-l": {
      "size": {
        "$type": "dimension",
        "$value": "32px",
        "$extensions": {
          "com.sharon.screen-class": {
            "compact": "24px",
            "medium": "28px"
          }
        }
      },
      "line-height": {
        "$type": "number",
        "$value": 1.25,
        "$extensions": {
          "com.sharon.screen-class": {
            "compact": 1.33333,
            "medium": 1.28571
          }
        }
      }
    },
