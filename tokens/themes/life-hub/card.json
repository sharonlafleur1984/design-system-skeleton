{
  "card": {
    "surface": {
      "$value": "transparent",
      "$type": "color",
      "$description": "Under the frost. Life Hub cards are glass, so nothing solid."
    },
    "frost": {
      "$value": "radial-gradient(130% 130% at 100% 0%, rgb(253 251 241 / 0.91), rgb(253 251 249 / 0.83) 55%, rgb(250 247 241 / 0.83))",
      "$description": "Light mode glass: a frosted fill, brightest toward the sun (top right). Dashboard by default."
    },
    "backdrop": {
      "$value": "blur(12px)",
      "$description": "Blurs the marble behind the frost."
    },
    "frost-feather": {
      "$value": "8px",
      "$type": "dimension",
      "$description": "Soft edge where the frost fades, so a thin clear band of glass shows at the rim."
    },
    "border": {
      "$value": "transparent",
      "$type": "color"
    },
    "shadow": {
      "$value": "0px 0px 0px 0px rgba(0,0,0,0)",
      "$description": "No extra shadow: glass cards take theirs from the light (card.glass)."
    },
    "shadow-hover": {
      "$value": "0px 0px 0px 0px rgba(0,0,0,0)"
    },
    "glass": {
      "$description": "The shared glass recipe's settings for cards (see glass.css): rim, glint, highlight, shade and shadow, all aimed at the page's one light.",
      "rim-color": {
        "$type": "color",
        "$value": "rgb(253 251 241)"
      },
      "rim-strength": {
        "$type": "number",
        "$value": 1.0
      },
      "rim-glint": {
        "$type": "number",
        "$value": 0.6
      },
      "rim-spread-x": {
        "$type": "dimension",
        "$value": "60%"
      },
      "rim-spread-y": {
        "$type": "dimension",
        "$value": "150%"
      },
      "rim-base": {
        "$type": "color",
        "$value": "rgb(42 38 37 / 0.1)"
      },
      "highlight": {
        "$type": "color",
        "$value": "rgb(253 251 241 / 0.8)"
      },
      "shade": {
        "$type": "color",
        "$value": "rgb(42 38 37 / 0.11)"
      },
      "cast": {
        "$type": "color",
        "$value": "rgb(42 38 37 / 0.137)"
      },
      "contact": {
        "$type": "color",
        "$value": "rgb(42 38 37 / 0.084)"
      },
      "cast-distance": {
        "$type": "dimension",
        "$value": "11.3px"
      },
      "cast-blur": {
        "$type": "dimension",
        "$value": "26px"
      }
    }
  }
}
