{
  "shadow": {
    "edge": {
      "$type": "shadow",
      "$value": [
        {
          "color": "rgba(255,250,241,0.90)",
          "offsetX": "0px",
          "offsetY": "1px",
          "blur": "0px",
          "spread": "0px",
          "inset": true
        }
      ]
    },
    "rest": {
      "$type": "shadow",
      "$value": [
        {
          "color": "rgba(6,48,44,0.05)",
          "offsetX": "0px",
          "offsetY": "1px",
          "blur": "2px",
          "spread": "0px"
        }
      ]
    },
    "hover": {
      "$type": "shadow",
      "$value": [
        {
          "color": "rgba(6,48,44,0.06)",
          "offsetX": "-1px",
          "offsetY": "2px",
          "blur": "4px",
          "spread": "0px"
        },
        {
          "color": "rgba(6,48,44,0.16)",
          "offsetX": "-1px",
          "offsetY": "8px",
          "blur": "18px",
          "spread": "-10px"
        }
      ]
    },
    "float": {
      "$type": "shadow",
      "$value": [
        {
          "color": "rgba(6,48,44,0.07)",
          "offsetX": "-2px",
          "offsetY": "4px",
          "blur": "10px",
          "spread": "0px"
        },
        {
          "color": "rgba(6,48,44,0.26)",
          "offsetX": "-2px",
          "offsetY": "24px",
          "blur": "48px",
          "spread": "-20px"
        }
      ]
    }
  }
}
