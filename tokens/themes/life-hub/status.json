{
  "color": {
    "status": {
      "$description": "Life Hub's status colors, from its own palette (Oct 14): error is berry pie, warning sunflower, success earth moss, info seagull, neutral morning latte, so they never match another theme's. The names and rules are shared by every theme (always with an icon and a label, text passes 4.5:1); the values are this theme's own.",
      "error": {
        "surface": {
          "$type": "color",
          "$value": "{palette.berry-pie.100}"
        },
        "accent": {
          "$type": "color",
          "$value": "{palette.berry-pie.600}"
        },
        "accent-strong": {
          "$type": "color",
          "$value": "{palette.berry-pie.700}"
        },
        "ink": {
          "$type": "color",
          "$value": "{palette.berry-pie.800}"
        }
      },
      "warning": {
        "surface": {
          "$type": "color",
          "$value": "{palette.sunflower-medley.50}"
        },
        "accent": {
          "$type": "color",
          "$value": "{palette.sunflower-medley.500}"
        },
        "accent-strong": {
          "$type": "color",
          "$value": "{palette.sunflower-medley.700}"
        },
        "ink": {
          "$type": "color",
          "$value": "{palette.sunflower-medley.800}"
        }
      },
      "success": {
        "surface": {
          "$type": "color",
          "$value": "{palette.earth-moss.100}"
        },
        "accent": {
          "$type": "color",
          "$value": "{palette.earth-moss.500}"
        },
        "accent-strong": {
          "$type": "color",
          "$value": "{palette.earth-moss.700}"
        },
        "ink": {
          "$type": "color",
          "$value": "{palette.earth-moss.800}"
        }
      },
      "info": {
        "surface": {
          "$type": "color",
          "$value": "{palette.seagull.100}"
        },
        "accent": {
          "$type": "color",
          "$value": "{palette.seagull.600}"
        },
        "accent-strong": {
          "$type": "color",
          "$value": "{palette.seagull.700}"
        },
        "ink": {
          "$type": "color",
          "$value": "{palette.seagull.800}"
        }
      },
      "neutral": {
        "surface": {
          "$type": "color",
          "$value": "{palette.morning-latte.100}"
        },
        "accent": {
          "$type": "color",
          "$value": "{palette.morning-latte.500}"
        },
        "accent-strong": {
          "$type": "color",
          "$value": "{palette.morning-latte.700}"
        },
        "ink": {
          "$type": "color",
          "$value": "{palette.morning-latte.800}"
        }
      }
    }
  }
