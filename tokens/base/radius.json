{
  "radius": {
    "number": {
      "$type": "dimension",
      "$value": "0px"
    },
    "xs": {
      "$type": "dimension",
      "$value": "4px"
    },
    "sm": {
      "$type": "dimension",
      "$value": "8px"
    },
    "md": {
      "$type": "dimension",
      "$value": "12px"
    },
    "lg": {
      "$type": "dimension",
      "$value": "16px"
    },
    "xl": {
      "$type": "dimension",
      "$value": "24px"
    },
    "pill": {
      "$type": "dimension",
      "$value": "999px"
    },
    "roundness": {
      "square": {
        "$type": "number",
        "$value": 0.2,
        "$description": "Square: nearly square corners, softened just enough not to look harsh."
      },
      "standard": {
        "$type": "number",
        "$value": 0.6,
        "$description": "Standard: the middle."
      },
      "round": {
        "$type": "number",
        "$value": 0.9,
        "$description": "Round: nearly a pill on buttons and soft on cards."
      }
    }
  }
}
